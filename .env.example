# =============================================================================
# LMS VIDEO AUTOMATOR - ENVIRONMENT CONFIGURATION
# =============================================================================
# NEVER commit this file to version control
# Copy to .env and fill in your values

# ---- CREDENTIALS ------------------------------------------------------------
LMS_EMAIL=your@email.com
LMS_PASSWORD=yourpassword
LMS_URL=https://lms.aimdip.org

# ---- BROWSER SETTINGS -------------------------------------------------------
HEADLESS=true
# Viewport randomized per session; this is the base
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
# Slowdown between actions in ms (helps with anti-detection)
SLOW_MO=0

# ---- CONCURRENCY ------------------------------------------------------------
# Max simultaneous browser contexts watching videos
MAX_CONCURRENCY=2

# ---- RETRY / RESILIENCE -----------------------------------------------------
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=5000
# Navigation timeout in ms
NAV_TIMEOUT=60000
# How long to wait for YouTube player to initialise
PLAYER_INIT_TIMEOUT=30000

# ---- COMPLETION THRESHOLD ---------------------------------------------------
# Platform requires 90%; set to 92 for safety margin
WATCH_PERCENTAGE=92

# ---- SESSION STORAGE --------------------------------------------------------
SESSION_DIR=./sessions
SCREENSHOT_DIR=./screenshots

# ---- LOGGING ----------------------------------------------------------------
LOG_LEVEL=info
LOG_DIR=./logs

# ---- HEALTH CHECK SERVER ----------------------------------------------------
HEALTH_PORT=3001

# ---- NOTIFICATIONS ----------------------------------------------------------
# Leave blank to disable that channel
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_EMAIL=
# Generic webhook (POST JSON payload)
GENERIC_WEBHOOK_URL=

# ---- DAILY REPORT -----------------------------------------------------------
# Cron expression (default: 11:59 PM every day)
REPORT_CRON=59 23 * * *
